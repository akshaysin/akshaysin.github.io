---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found - ${SITE_TITLE}`} description="The page you were looking for does not exist." />
		<meta name="robots" content="noindex" />
		<style>
			main {
				text-align: center;
			}
			.code {
				font-size: 5rem;
				font-weight: 700;
				color: var(--accent);
				line-height: 1;
				margin-bottom: 0.25em;
			}
			.links {
				display: flex;
				gap: 1rem;
				justify-content: center;
				flex-wrap: wrap;
				margin-top: 2rem;
			}
			.links a {
				display: inline-block;
				padding: 0.7rem 1.6rem;
				background: var(--accent);
				color: #fff;
				text-decoration: none;
				border-radius: 8px;
				font-weight: 600;
			}
			.links a:hover {
				background: var(--accent-dark);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="code">404</p>
			<h1>This page moved or never existed</h1>
			<p>
				This site was rebuilt in 2025 and most posts now live under <code>/blog/</code>.
				If you followed an old link, the post is probably still here under a new address.
			</p>
			<div class="links">
				<a href="/blog/">Browse all posts</a>
				<a href="/">Go to the homepage</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

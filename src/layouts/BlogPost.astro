---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type PostData = CollectionEntry<'blog'>['data'];

// Static pages (e.g. /about) reuse this layout, so everything beyond the three
// fields it actually needs to render is optional.
type Props = Partial<PostData> &
	Pick<PostData, 'title' | 'description' | 'pubDate'> & {
		/** Render the hero as a small thumbnail instead of a full-width banner. */
		compactHero?: boolean;
		/** Static pages that reuse this layout should pass `website`. */
		pageType?: 'website' | 'article';
	};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt,
	category,
	tags,
	compactHero = false,
	pageType = 'article',
} = Astro.props;

// Several posts repeat the category inside their tag list; show it once.
const visibleTags = (tags ?? []).filter(
	(tag) => tag.toLowerCase() !== category?.toLowerCase(),
);
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type={pageType}
			publishedTime={pubDate}
			modifiedTime={updatedDate}
		/>
		<style>
			main {
				padding: 2rem 0;
			}
			.hero-image {
				width: 100%;
				margin-bottom: 2rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				max-width: 700px;
				width: 100%;
			}
			.hero-image.compact img {
				max-width: 120px;
				border-radius: 50%;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 2em;
				padding: 1em 0;
				text-align: center;
				line-height: 1.2;
			}
			.title h1 {
				font-size: 2.2em;
				margin: 0 0 0.5em 0;
				font-weight: 700;
				color: rgb(var(--black));
			}
			.date {
				margin-bottom: 1em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.last-updated-on {
				font-style: italic;
			}
			hr {
				margin-top: 1.5rem;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				justify-content: center;
				margin-bottom: 1em;
			}
			.meta span {
				font-size: 0.75em;
				padding: 0.2em 0.8em;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.meta .category {
				background: var(--accent);
				color: #fff;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class:list={['hero-image', { compact: compactHero }]}>
					{
						heroImage && (
							<Image
								width={compactHero ? 240 : 700}
								height={compactHero ? 240 : 350}
								src={heroImage}
								alt={heroImageAlt ?? ''}
								loading="eager"
								fit="cover"
							/>
						)
					}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							(category || visibleTags.length > 0) && (
								<div class="meta">
									{category && <span class="category">{category}</span>}
									{visibleTags.map((tag) => (
										<span>{tag}</span>
									))}
								</div>
							)
						}
						<hr />
					</div>
					<slot />

				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
